---
import BaseLayout from '../layouts/BaseLayout.astro';
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'WidgetWorks',
  url: 'https://widgetworks.example/',
  logo: 'https://widgetworks.example/logo.png',
};
---
<BaseLayout title="Espresso Machine Repair Kits | WidgetWorks">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(org)} />
  <h1>Repair kits for vintage espresso machines</h1>
  <p>Gaskets, shower screens, and steam valves for lever machines made between 1955 and 1990. Every kit ships with a printed guide and the tools you need, and each part is tested on a working machine before it leaves the shop in Toledo, Ohio.</p>
  <img src="/kit.webp" alt="Gasket repair kit laid out on a workbench" width="800" height="600" />
</BaseLayout>
